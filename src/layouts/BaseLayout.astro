---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeHint from "../components/ThemeHint.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noHeader?: boolean;
  noFooter?: boolean;
  jsonLd?: object;
}

const {
  title = "sudo make vibe",
  description = "Linux · AI · Raspberry Pi · Cybersecurity — where the command line meets the creative line",
  ogImage = "/og-default.png",
  ogType = "website",
  noHeader = false,
  noFooter = false,
  jsonLd,
} = Astro.props;

const siteUrl = "https://sudomakevibe.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "sudo make vibe",
  url: siteUrl,
  description,
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/blog?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="sudo make vibe" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="alternate" type="application/rss+xml" title="sudo make vibe RSS Feed" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!--
      FOUR THEMES INLINED — no network fetch, no flash.
      Sudo Dark + Sudo Light are the brand palettes.
      Arctic Frost (Nord) + Earthy Glow (Solarized) are kept as
      well-researched community favourites with Phase 1 fixes applied.
    -->
    <style>
      /* ── Sudo Dark — brand palette, warm navy ─────────────────── */
      /* accent boosted #2c7da0→#3d8ab5 (AA Large→AA)             */
      /* border strengthened for card edge visibility               */
      [data-theme="sudo-dark"] {
        /* Shiki syntax highlighting */
        --astro-code-background: #071018;
        --astro-code-foreground: #7dd3fc;
        --astro-code-token-keyword: #3d8ab5;
        --astro-code-token-string: #4a8a4a;
        --astro-code-token-comment: #3a5a70;
        --astro-code-token-constant: #f472b6;
        --astro-code-token-function: #318bbf;
        --astro-code-token-string-expression: #4a8a4a;
        --astro-code-token-punctuation: #7a9bb5;
        --astro-code-token-link: #3d8ab5;

        --bg-primary:    #0b1623;
        --bg-secondary:  #0d1a2a;
        --bg-card:       #112033;
        --text-primary:  #bdd0e0;
        --text-secondary:#7a9bb5;
        --accent:        #3d8ab5;
        --accent-hover:  #5aadd4;
        --code-bg:       #071018;
        --code-text:     #7dd3fc;
        --border:        #2a4d6e;
        --selection-bg:  #3d8ab5;
        --selection-text:#bdd0e0;
        --cursor:        #3d8ab5;
        --diagram-infra: #4A8A4A;
        --diagram-infra-fill: #1A2E1A;
        --diagram-infra-text: #80C080;
        --diagram-compute: #318BBF;
        --diagram-compute-fill: #1A3A52;
        --diagram-compute-text: #8BBFD4;
        --diagram-compute-sub: #5A8FA8;
        --diagram-ai: #2A9DBF;
        --diagram-ai-fill: #0D2E3A;
        --diagram-ai-text: #5ACFE0;
        --diagram-devops: #2A9D8F;
        --diagram-devops-fill: #0D3D3D;
        --diagram-devops-text: #5ECFC4;
        --diagram-dev: #6B5FD4;
        --diagram-dev-fill: #1E1A3A;
        --diagram-dev-text: #A89FE8;
        --diagram-dev-sub: #7A6FC4;
        --diagram-windows: #4A6A7A;
        --diagram-windows-fill: #1E2A30;
        --diagram-windows-text: #8AAABB;
        --diagram-external: #4A7A8A;
        --diagram-external-fill: #1E2A2E;
        --diagram-external-text: #8AAABB;
        --diagram-tailscale: #4A8A4A;
      }

      /* ── Sudo Light — brand palette, cool white ───────────────── */
      /* accent darkened #2c7da0→#236a8a for light bg (AA Large→AA)*/
      /* secondary darkened for better hierarchy on light           */
      /* border strengthened for card edge visibility               */
      [data-theme="sudo-light"] {
        /* Shiki syntax highlighting */
        --astro-code-background: #ddeaf4;
        --astro-code-foreground: #0f2033;
        --astro-code-token-keyword: #236a8a;
        --astro-code-token-string: #3a7a3a;
        --astro-code-token-comment: #6a8a9a;
        --astro-code-token-constant: #c95a0f;
        --astro-code-token-function: #2878a8;
        --astro-code-token-string-expression: #3a7a3a;
        --astro-code-token-punctuation: #3d6070;
        --astro-code-token-link: #236a8a;

        --bg-primary:    #f4f8fb;
        --bg-secondary:  #eaf1f7;
        --bg-card:       #e8f0f7;
        --text-primary:  #0f2033;
        --text-secondary:#3d6070;
        --accent:        #236a8a;
        --accent-hover:  #1a5a78;
        --code-bg:       #ddeaf4;
        --code-text:     #1e5f7a;
        --border:        #a8c4d8;
        --selection-bg:  #236a8a;
        --selection-text:#f4f8fb;
        --cursor:        #236a8a;
        --diagram-infra: #3A7A3A;
        --diagram-infra-fill: #D8EED8;
        --diagram-infra-text: #2A5A2A;
        --diagram-compute: #2878A8;
        --diagram-compute-fill: #D0E8F4;
        --diagram-compute-text: #1A5880;
        --diagram-compute-sub: #3A78A0;
        --diagram-ai: #1A88A8;
        --diagram-ai-fill: #C8EAF4;
        --diagram-ai-text: #0A6888;
        --diagram-devops: #1A8880;
        --diagram-devops-fill: #C8EAE8;
        --diagram-devops-text: #0A5850;
        --diagram-dev: #5848C0;
        --diagram-dev-fill: #E0DCF8;
        --diagram-dev-text: #3830A0;
        --diagram-dev-sub: #5848B8;
        --diagram-windows: #3A5868;
        --diagram-windows-fill: #D0DDE4;
        --diagram-windows-text: #2A4858;
        --diagram-external: #3A5868;
        --diagram-external-fill: #C8D8E0;
        --diagram-external-text: #2A4858;
        --diagram-tailscale: #3A7A3A;
      }

      /* ── Arctic Frost — Nord-based, contrast optimised ────────── */
      /* accent boosted #5e9fd4→#6aaee0 (AA Large→AA)              */
      /* secondary lightened for card readability                   */
      /* border strengthened for card edge visibility               */
      [data-theme="arctic-frost"] {
        /* Shiki syntax highlighting */
        --astro-code-background: #2a3140;
        --astro-code-foreground: #ccd2dc;
        --astro-code-token-keyword: #6aaee0;
        --astro-code-token-string: #a3be8c;
        --astro-code-token-comment: #616e88;
        --astro-code-token-constant: #d08770;
        --astro-code-token-function: #88c0d0;
        --astro-code-token-string-expression: #a3be8c;
        --astro-code-token-punctuation: #a8b4c0;
        --astro-code-token-link: #6aaee0;

        --bg-primary:    #2e3440;
        --bg-secondary:  #353c4a;
        --bg-card:       #424c5e;
        --text-primary:  #ccd2dc;
        --text-secondary:#a8b4c0;
        --accent:        #6aaee0;
        --accent-hover:  #85c4ee;
        --code-bg:       #2a3140;
        --code-text:     #d08770;
        --border:        #566070;
        --selection-bg:  #6aaee0;
        --selection-text:#ccd2dc;
        --cursor:        #6aaee0;
        --diagram-infra: #5A9A5A;
        --diagram-infra-fill: #2A3E2A;
        --diagram-infra-text: #90D090;
        --diagram-compute: #88C0D0;
        --diagram-compute-fill: #2A3E4A;
        --diagram-compute-text: #A8D8E8;
        --diagram-compute-sub: #78A8B8;
        --diagram-ai: #5ABCD8;
        --diagram-ai-fill: #1E3A48;
        --diagram-ai-text: #7AD8F0;
        --diagram-devops: #3AADA0;
        --diagram-devops-fill: #1E3A38;
        --diagram-devops-text: #6ECFC4;
        --diagram-dev: #7B70E0;
        --diagram-dev-fill: #2A2848;
        --diagram-dev-text: #B8B0F8;
        --diagram-dev-sub: #8A80D8;
        --diagram-windows: #5A7A8A;
        --diagram-windows-fill: #2A3840;
        --diagram-windows-text: #9ABBC8;
        --diagram-external: #5A8A9A;
        --diagram-external-fill: #243840;
        --diagram-external-text: #9ABBC8;
        --diagram-tailscale: #5A9A5A;
      }

      /* ── Solar Bloom — Solarized Light, warm brown accent ────────── */
      /* Solarized Light base3/base2 cream backgrounds              */
      /* Caramel accent on cream — distinctive warm earth aesthetic */
      /* All pairs WCAG AA verified                                  */
      [data-theme="solar-bloom"] {
        --bg-primary:    #fdf6e3;
        --bg-secondary:  #eee8d5;
        --bg-card:       #eee8d5;
        --text-primary:  #586e75;
        --text-secondary:#586e75;
        --accent:        #8b5a2b;
        --accent-hover:  #6f3f1a;
        --code-bg:       #eee8d5;
        --code-text:     #7d3505;
        --border:        #7a8a8a;
        --selection-bg:  #8b5a2b;
        --selection-text:#fdf6e3;
        --cursor:        #8b5a2b;
        --diagram-infra: #5d3517;
        --diagram-infra-fill: #eee8d5;
        --diagram-infra-text: #4a2a12;
        --diagram-compute: #8b5a2b;
        --diagram-compute-fill: #f5efd9;
        --diagram-compute-text: #6f3f1a;
        --diagram-compute-sub: #7d4a1f;
        --diagram-ai: #6f3f1a;
        --diagram-ai-fill: #f5efd9;
        --diagram-ai-text: #5d3517;
        --diagram-devops: #7d4a1f;
        --diagram-devops-fill: #f5efd9;
        --diagram-devops-text: #5a3413;
        --diagram-dev: #6c5b3e;
        --diagram-dev-fill: #f0eadc;
        --diagram-dev-text: #4a3f29;
        --diagram-dev-sub: #7a6850;
        --diagram-windows: #7a8a8a;
        --diagram-windows-fill: #e8e3d0;
        --diagram-windows-text: #586e75;
        --diagram-external: #93a1a1;
        --diagram-external-fill: #e8e3d0;
        --diagram-external-text: #586e75;
        --diagram-tailscale: #5d3517;
        /* Shiki syntax highlighting */
        --astro-code-background: #eee8d5;
        --astro-code-foreground: #586e75;
        --astro-code-token-keyword: #8b5a2b;
        --astro-code-token-string: #4a6e3a;
        --astro-code-token-comment: #93a1a1;
        --astro-code-token-constant: #a13a0e;
        --astro-code-token-function: #6f3f1a;
        --astro-code-token-string-expression: #4a6e3a;
        --astro-code-token-punctuation: #586e75;
        --astro-code-token-link: #8b5a2b;
      }
    </style>

    <!-- FOUC prevention: synchronous before first paint -->
    <script is:inline>
      (function () {
        var valid = ["sudo-dark", "sudo-light", "arctic-frost", "solar-bloom"];
        var saved = localStorage.getItem("blog-theme");
        var theme = valid.includes(saved) ? saved : "sudo-dark";
        document.documentElement.setAttribute("data-theme", theme);
        var backgrounds = {
          "sudo-dark":    "#0b1623",
          "sudo-light":   "#f4f8fb",
          "arctic-frost": "#2e3440",
          "solar-bloom":  "#fdf6e3",
        };
        document.documentElement.style.backgroundColor = backgrounds[theme] || "#0b1623";
      })();
    </script>
  </head>
  <body>
    {!noHeader && <Header />}
    <slot />
    {!noFooter && <Footer />}
    <ThemeHint />
  </body>
</html>
